// Publicação no Cloudflare Workers como site estático (pasta out/ gerada pelo build).
// O endereço fica: https://iuran-freire-portfolio.<seu-subdominio>.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iuran-freire-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
